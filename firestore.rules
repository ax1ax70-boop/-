rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email in ['rawayiealeilm@gmail.com', 'ax1ax70@gmail.com']
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isValidCreatedAt(data) {
      return data.createdAt == request.time;
    }

    function hasImmutableCreatedAt(data) {
      return data.createdAt == existing().createdAt;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt'])
        && data.keys().hasOnly(['email', 'role', 'createdAt'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.role in ['admin', 'editor'];
    }

    function isValidSitePost(data) {
      return data.keys().hasAll(['id', 'title', 'excerpt', 'body', 'author', 'category', 'mediaType', 'cardTheme', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'title', 'excerpt', 'body', 'author', 'sourceLabel', 'category',
          'mediaType', 'cardTheme', 'youtubeUrl', 'publishedAtLabel', 'likes',
          'commentsCount', 'hidden', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 260
        && data.excerpt is string && data.excerpt.size() >= 1 && data.excerpt.size() <= 1200
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 30000
        && data.author is string && data.author.size() >= 1 && data.author.size() <= 160
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && data.mediaType in ['quote', 'sada', 'video', 'audio']
        && data.cardTheme in ['emerald', 'azure', 'gold', 'midnight']
        && (!('sourceLabel' in data) || (data.sourceLabel is string && data.sourceLabel.size() <= 160))
        && (!('youtubeUrl' in data) || (data.youtubeUrl is string && data.youtubeUrl.size() <= 400))
        && (!('publishedAtLabel' in data) || (data.publishedAtLabel is string && data.publishedAtLabel.size() <= 80))
        && (!('likes' in data) || (data.likes is int && data.likes >= 0))
        && (!('commentsCount' in data) || (data.commentsCount is int && data.commentsCount >= 0))
        && (!('hidden' in data) || data.hidden is bool);
    }

    function isValidSiteFatwa(data) {
      return data.keys().hasAll(['id', 'scholarId', 'scholarName', 'category', 'question', 'answer', 'source', 'createdAt'])
        && data.keys().hasOnly(['id', 'scholarId', 'scholarName', 'category', 'question', 'answer', 'source', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.scholarId in ['hajouri', 'wadaei', 'binbaz', 'uthaymeen', 'albani']
        && data.scholarName is string && data.scholarName.size() >= 1 && data.scholarName.size() <= 160
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && data.question is string && data.question.size() >= 3 && data.question.size() <= 3000
        && data.answer is string && data.answer.size() >= 3 && data.answer.size() <= 25000
        && data.source is string && data.source.size() >= 1 && data.source.size() <= 240;
    }

    function isValidMotherOasisRecord(data) {
      return data.keys().hasAll(['id', 'chapter', 'title', 'body', 'signature', 'createdAt'])
        && data.keys().hasOnly(['id', 'chapter', 'title', 'body', 'signature', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.chapter in ['books', 'lectures', 'stories']
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 260
        && data.body is string && data.body.size() >= 3 && data.body.size() <= 40000
        && data.signature is string && data.signature.size() >= 2 && data.signature.size() <= 220;
    }

    function isValidPoetryRecord(data) {
      return data.keys().hasAll(['id', 'kind', 'title', 'author', 'body', 'createdAt'])
        && data.keys().hasOnly(['id', 'kind', 'title', 'author', 'summary', 'body', 'sourceUrl', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.kind in ['islamic_poetry', 'anecdote']
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 260
        && data.author is string && data.author.size() >= 1 && data.author.size() <= 160
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 600))
        && data.body is string && data.body.size() >= 3 && data.body.size() <= 20000
        && (!('sourceUrl' in data) || (data.sourceUrl is string && data.sourceUrl.size() <= 400));
    }

    function isValidDeafMuteVideo(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'status', 'category', 'managerName', 'createdAt'])
        && data.keys().hasOnly(['id', 'title', 'description', 'benefitText', 'youtubeUrl', 'status', 'category', 'managerName', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 240
        && data.description is string && data.description.size() >= 2 && data.description.size() <= 3000
        && (!('benefitText' in data) || (data.benefitText is string && data.benefitText.size() <= 4000))
        && (!('youtubeUrl' in data) || (data.youtubeUrl is string && data.youtubeUrl.size() <= 500))
        && data.status in ['published', 'upcoming']
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && data.managerName is string && data.managerName.size() >= 2 && data.managerName.size() <= 140;
    }

    function isValidCustomAdhkar(data) {
      return data.keys().hasAll(['id', 'chapterId', 'text', 'targetCount', 'source', 'createdAt'])
        && data.keys().hasOnly(['id', 'chapterId', 'title', 'text', 'fadl', 'targetCount', 'source', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.chapterId is string && data.chapterId.size() >= 2 && data.chapterId.size() <= 80
        && (!('title' in data) || (data.title is string && data.title.size() <= 200))
        && data.text is string && data.text.size() >= 3 && data.text.size() <= 6000
        && (!('fadl' in data) || (data.fadl is string && data.fadl.size() <= 2000))
        && data.targetCount is int && data.targetCount >= 1 && data.targetCount <= 1000
        && data.source is string && data.source.size() >= 1 && data.source.size() <= 240;
    }

    function isValidCustomBook(data) {
      return data.keys().hasAll(['id', 'section', 'title', 'author', 'category', 'pdfUrl', 'createdAt'])
        && data.keys().hasOnly(['id', 'section', 'title', 'author', 'category', 'summary', 'pdfUrl', 'pages', 'sizeLabel', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.section in ['hajouri', 'imams', 'students']
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 260
        && data.author is string && data.author.size() >= 2 && data.author.size() <= 180
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && (!('summary' in data) || (data.summary is string && data.summary.size() <= 2500))
        && data.pdfUrl is string && data.pdfUrl.size() >= 4 && data.pdfUrl.size() <= 600
        && (!('pages' in data) || (data.pages is int && data.pages >= 0 && data.pages <= 10000))
        && (!('sizeLabel' in data) || (data.sizeLabel is string && data.sizeLabel.size() <= 60));
    }

    function isValidVisitorReview(data) {
      return data.keys().hasAll(['id', 'name', 'rating', 'comment', 'hidden', 'createdAt'])
        && data.keys().hasOnly(['id', 'name', 'rating', 'comment', 'role', 'hidden', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.rating is int && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 2 && data.comment.size() <= 2000
        && (!('role' in data) || (data.role is string && data.role.size() <= 120))
        && data.hidden is bool;
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll(['appName', 'updatedAt'])
        && data.keys().hasOnly([
          'appName', 'appTagline', 'brandHandle', 'heroWisdomText', 'heroWisdomAuthor',
          'motherPrayerText', 'maintenanceMode', 'updatedAt'
        ])
        && data.appName is string && data.appName.size() >= 1 && data.appName.size() <= 120
        && (!('appTagline' in data) || (data.appTagline is string && data.appTagline.size() <= 260))
        && (!('brandHandle' in data) || (data.brandHandle is string && data.brandHandle.size() <= 80))
        && (!('heroWisdomText' in data) || (data.heroWisdomText is string && data.heroWisdomText.size() <= 2000))
        && (!('heroWisdomAuthor' in data) || (data.heroWisdomAuthor is string && data.heroWisdomAuthor.size() <= 160))
        && (!('motherPrayerText' in data) || (data.motherPrayerText is string && data.motherPrayerText.size() <= 2000))
        && (!('maintenanceMode' in data) || data.maintenanceMode is bool);
    }

    function isValidSadaMaterial(data) {
      return data.keys().hasAll(['id', 'scholarName', 'title', 'category', 'contentType', 'body', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'scholarName', 'title', 'category', 'contentType',
          'body', 'externalUrl', 'sourceLabel', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.scholarName is string && data.scholarName.size() >= 2 && data.scholarName.size() <= 180
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 260
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && data.contentType in ['article', 'audio_link', 'video_link', 'fatwa', 'poetry']
        && data.body is string && data.body.size() >= 3 && data.body.size() <= 30000
        && (!('externalUrl' in data) || (data.externalUrl is string && data.externalUrl.size() <= 600))
        && (!('sourceLabel' in data) || (data.sourceLabel is string && data.sourceLabel.size() <= 180));
    }

    function isValidAiDawahCard(data) {
      return data.keys().hasAll(['id', 'speakerLine', 'lines', 'source', 'category', 'isAiGenerated', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'speakerLine', 'lines', 'source', 'category',
          'isAiGenerated', 'isTrending', 'engagementCount', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.speakerLine is string && data.speakerLine.size() >= 2 && data.speakerLine.size() <= 220
        && data.lines is list && data.lines.size() >= 1 && data.lines.size() <= 6
        && data.source is string && data.source.size() >= 2 && data.source.size() <= 220
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 100
        && data.isAiGenerated is bool
        && (!('isTrending' in data) || data.isTrending is bool)
        && (!('engagementCount' in data) || (data.engagementCount is int && data.engagementCount >= 0));
    }

    function isValidVisitorProfile(data) {
      return data.keys().hasAll(['id', 'provider', 'name', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'provider', 'name', 'email', 'whatsapp',
          'likedPostIds', 'bookmarkedPostIds', 'bookmarkedFatwaIds',
          'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() >= 2 && data.id.size() <= 128
        && data.provider in ['google', 'facebook', 'email']
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 140
        && (!('email' in data) || (data.email is string && data.email.size() <= 180))
        && (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 40))
        && (!('likedPostIds' in data) || (data.likedPostIds is list && data.likedPostIds.size() <= 200))
        && (!('bookmarkedPostIds' in data) || (data.bookmarkedPostIds is list && data.bookmarkedPostIds.size() <= 200))
        && (!('bookmarkedFatwaIds' in data) || (data.bookmarkedFatwaIds is list && data.bookmarkedFatwaIds.size() <= 200));
    }

    function isValidTelemetryCounters(data) {
      return data.keys().hasAll(['visitorsCount', 'clicksCount', 'motherPrayersCount', 'registeredMembersCount', 'updatedAt'])
        && data.keys().hasOnly(['visitorsCount', 'clicksCount', 'motherPrayersCount', 'registeredMembersCount', 'updatedAt'])
        && data.visitorsCount is int && data.visitorsCount >= 4580
        && data.clicksCount is int && data.clicksCount >= 0
        && data.motherPrayersCount is int && data.motherPrayersCount >= 0
        && data.registeredMembersCount is int && data.registeredMembersCount >= 0
        && data.updatedAt is timestamp;
    }

    function isValidPublicMember(data) {
      return data.keys().hasAll(['id', 'displayName', 'createdAt'])
        && data.keys().hasOnly(['id', 'displayName', 'lastLoginAt', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64))
        && data.createdAt is timestamp
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidQuizLeaderboardEntry(data) {
      return data.keys().hasAll(['id', 'nickname', 'category', 'score', 'correctCount', 'totalQuestions', 'createdAt'])
        && data.keys().hasOnly([
          'id', 'nickname', 'category', 'score', 'correctCount',
          'totalQuestions', 'streakDays', 'dateKey', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.nickname is string && data.nickname.size() >= 2 && data.nickname.size() <= 40
        && data.category in ['all', 'aqeedah', 'quran', 'hadith_seerah', 'fiqh', 'akhlaq']
        && data.score is int && data.score >= 0 && data.score <= 50000
        && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 500
        && data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 500
        && (!('streakDays' in data) || (data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 3650))
        && (!('dateKey' in data) || (data.dateKey is string && data.dateKey.size() <= 16));
    }

    // Connection test probe (safe single-doc get)
    match /test/connection {
      allow get: if true;
    }

    // Trusted Admins Collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow create, update: if isAdmin() && isValidId(adminId) && isValidAdminRecord(incoming());
      allow delete: if isAdmin() && isValidId(adminId) && adminId != request.auth.uid;
    }

    // Public Content Collections (Cloud Persisted Across Devices & Reinstalls)
    match /site_posts/{postId} {
      allow get: if isValidId(postId) && (existing().hidden != true || isAdmin());
      allow list: if resource.data.hidden != true || isAdmin();
      allow create: if isAdmin() && isValidId(postId) && isValidSitePost(incoming()) && incoming().id == postId && isValidCreatedAt(incoming());
      allow update: if isAdmin() && isValidId(postId) && isValidSitePost(incoming())
        && hasImmutableCreatedAt(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'excerpt', 'body', 'author', 'sourceLabel', 'category',
          'mediaType', 'cardTheme', 'youtubeUrl', 'publishedAtLabel', 'hidden', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(postId);
    }

    match /site_fatawa/{fatwaId} {
      allow get: if isValidId(fatwaId);
      allow list: if resource.data.scholarId in ['hajouri', 'wadaei', 'binbaz', 'uthaymeen', 'albani'];
      allow create: if isAdmin() && isValidId(fatwaId) && isValidSiteFatwa(incoming()) && incoming().id == fatwaId && isValidCreatedAt(incoming());
      allow update: if isAdmin() && isValidId(fatwaId) && isValidSiteFatwa(incoming())
        && hasImmutableCreatedAt(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'scholarId', 'scholarName', 'category', 'question', 'answer', 'source', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(fatwaId);
    }

    match /mother_oasis_items/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if resource.data.chapter in ['books', 'lectures', 'stories'];
      allow create: if isAdmin() && isValidId(itemId) && isValidMotherOasisRecord(incoming()) && incoming().id == itemId && isValidCreatedAt(incoming());
      allow update: if isAdmin() && isValidId(itemId) && isValidMotherOasisRecord(incoming())
        && hasImmutableCreatedAt(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['chapter', 'title', 'body', 'signature', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(itemId);
    }

    match /poetry_items/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if resource.data.kind in ['islamic_poetry', 'anecdote'];
      allow create: if isAdmin() && isValidId(itemId) && isValidPoetryRecord(incoming()) && incoming().id == itemId && isValidCreatedAt(incoming());
      allow update: if isAdmin() && isValidId(itemId) && isValidPoetryRecord(incoming())
        && hasImmutableCreatedAt(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['kind', 'title', 'author', 'summary', 'body', 'sourceUrl', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(itemId);
    }

    match /deaf_mute_videos/{videoId} {
      allow get: if isValidId(videoId);
      allow list: if resource.data.status in ['published', 'upcoming'];
      allow create: if isAdmin() && isValidId(videoId) && isValidDeafMuteVideo(incoming()) && incoming().id == videoId && isValidCreatedAt(incoming());
      allow update: if isAdmin() && isValidId(videoId) && isValidDeafMuteVideo(incoming())
        && hasImmutableCreatedAt(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'description', 'benefitText', 'youtubeUrl', 'status', 'category', 'managerName', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(videoId);
    }

    match /custom_adhkar/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if resource.data.targetCount >= 1;
      allow create: if isAdmin() && isValidId(itemId) && isValidCustomAdhkar(incoming()) && incoming().id == itemId && isValidCreatedAt(incoming());
      allow update: if isAdmin() && isValidId(itemId) && isValidCustomAdhkar(incoming())
        && hasImmutableCreatedAt(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'chapterId', 'title', 'text', 'fadl', 'targetCount', 'source', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(itemId);
    }

    match /library_books/{bookId} {
      allow get: if isValidId(bookId);
      allow list: if resource.data.section in ['hajouri', 'imams', 'students'];
      allow create: if isAdmin() && isValidId(bookId) && isValidCustomBook(incoming()) && incoming().id == bookId && isValidCreatedAt(incoming());
      allow update: if isAdmin() && isValidId(bookId) && isValidCustomBook(incoming())
        && hasImmutableCreatedAt(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'section', 'title', 'author', 'category', 'summary', 'pdfUrl', 'pages', 'sizeLabel', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(bookId);
    }

    match /visitor_reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (existing().hidden != true || isAdmin());
      allow list: if resource.data.hidden != true || isAdmin();
      allow create: if isValidId(reviewId)
        && isValidVisitorReview(incoming())
        && incoming().id == reviewId
        && incoming().hidden == false
        && isValidCreatedAt(incoming());
      allow update: if isAdmin() && isValidId(reviewId) && isValidVisitorReview(incoming())
        && hasImmutableCreatedAt(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['hidden', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(reviewId);
    }

    match /sada_materials/{materialId} {
      allow get: if isValidId(materialId);
      allow list: if resource.data.contentType in ['article', 'audio_link', 'video_link', 'fatwa', 'poetry'];
      allow create: if isAdmin() && isValidId(materialId) && isValidSadaMaterial(incoming()) && incoming().id == materialId && isValidCreatedAt(incoming());
      allow update: if isAdmin() && isValidId(materialId) && isValidSadaMaterial(incoming())
        && hasImmutableCreatedAt(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'scholarName', 'title', 'category', 'contentType', 'body', 'externalUrl', 'sourceLabel', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(materialId);
    }

    match /ai_dawah_cards/{cardId} {
      allow get: if isValidId(cardId);
      allow list: if resource.data.isAiGenerated == true;
      allow create: if isAdmin() && isValidId(cardId) && isValidAiDawahCard(incoming()) && incoming().id == cardId && isValidCreatedAt(incoming());
      allow update: if isAdmin() && isValidId(cardId) && isValidAiDawahCard(incoming())
        && hasImmutableCreatedAt(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'speakerLine', 'lines', 'source', 'category', 'isTrending', 'engagementCount', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(cardId);
    }

    // Strict PII-isolated visitor profile: owner-only or primary admin
    match /visitor_profiles/{profileId} {
      allow get: if isSignedIn() && isValidId(profileId) && (request.auth.uid == profileId || isAdmin());
      allow create: if isSignedIn() && isValidId(profileId) && request.auth.uid == profileId
        && isValidVisitorProfile(incoming()) && isValidCreatedAt(incoming());
      allow update: if isSignedIn() && isValidId(profileId) && (request.auth.uid == profileId || isAdmin())
        && isValidVisitorProfile(incoming())
        && hasImmutableCreatedAt(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'provider', 'name', 'email', 'whatsapp',
          'likedPostIds', 'bookmarkedPostIds', 'bookmarkedFatwaIds', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(profileId) && (request.auth.uid == profileId || isAdmin());
    }

    match /site_settings/{docId} {
      allow get: if isValidId(docId);
      allow list: if resource.data.appName is string;
      allow create: if isAdmin() && isValidId(docId) && isValidSiteSettings(incoming()) && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(docId) && isValidSiteSettings(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'appName', 'appTagline', 'brandHandle', 'heroWisdomText', 'heroWisdomAuthor',
          'motherPrayerText', 'maintenanceMode', 'updatedAt'
        ]);
    }

    // Global strictly monotonic telemetry counters (synced across devices & restarts)
    match /site_telemetry/{docId} {
      allow get: if docId == 'counters';
      allow create: if docId == 'counters'
        && isValidTelemetryCounters(incoming())
        && incoming().visitorsCount <= 250000;
      allow update: if docId == 'counters'
        && isValidTelemetryCounters(incoming())
        && incoming().visitorsCount >= existing().visitorsCount
        && incoming().visitorsCount <= existing().visitorsCount + 1000
        && incoming().clicksCount >= existing().clicksCount
        && incoming().clicksCount <= existing().clicksCount + 15000
        && incoming().motherPrayersCount >= existing().motherPrayersCount
        && incoming().motherPrayersCount <= existing().motherPrayersCount + 500
        && incoming().registeredMembersCount >= existing().registeredMembersCount
        && incoming().registeredMembersCount <= existing().registeredMembersCount + 100;
    }

    // Privacy-safe masked member labels (zero PII; persisted across restarts & devices)
    match /public_members/{memberId} {
      allow get: if isValidId(memberId);
      allow list: if resource.data.displayName is string;
      allow create: if isValidId(memberId)
        && isValidPublicMember(incoming())
        && incoming().id == memberId;
      allow update: if isValidId(memberId)
        && isValidPublicMember(incoming())
        && hasImmutableCreatedAt(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'lastLoginAt', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(memberId);
    }

    // Daily Dawah Quiz Leaderboard (privacy-safe nickname + monotonic score per category)
    match /quiz_leaderboard/{entryId} {
      allow get: if isValidId(entryId);
      allow list: if resource.data.category in ['all', 'aqeedah', 'quran', 'hadith_seerah', 'fiqh', 'akhlaq'];
      allow create: if isValidId(entryId)
        && isValidQuizLeaderboardEntry(incoming())
        && incoming().id == entryId
        && isValidCreatedAt(incoming())
        && (!('updatedAt' in incoming()) || incoming().updatedAt == request.time);
      allow update: if isValidId(entryId)
        && isValidQuizLeaderboardEntry(incoming())
        && hasImmutableCreatedAt(incoming())
        && incoming().id == existing().id
        && incoming().category == existing().category
        && incoming().score >= existing().score
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'nickname', 'score', 'correctCount', 'totalQuestions', 'streakDays', 'dateKey', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(entryId);
    }
  }
}
